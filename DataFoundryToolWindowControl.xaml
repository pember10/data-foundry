<UserControl x:Class="data_foundry.DataFoundryToolWindowControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="600" d:DesignWidth="800">
    <UserControl.Resources>
        <Style x:Key="TabItemHeaderStyle" TargetType="TabItem">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="16,8"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        
        <Style x:Key="SectionHeaderStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,0,0,12"/>
            <Setter Property="Foreground" Value="#2C2C2C"/>
        </Style>
        
        <Style x:Key="PrimaryButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#0078D4"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="16,8"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" 
                                CornerRadius="2" 
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#005A9E"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SecondaryButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#F3F3F3"/>
            <Setter Property="Foreground" Value="#2C2C2C"/>
            <Setter Property="BorderBrush" Value="#D1D1D1"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="16,8"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
    </UserControl.Resources>

    <Grid Background="#F3F3F3">
        <TabControl Margin="0" BorderThickness="0" Background="White">
            <!-- Overview Tab -->
            <TabItem Header="Overview" Style="{StaticResource TabItemHeaderStyle}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="20">
                        <TextBlock Text="Database Project Overview" Style="{StaticResource SectionHeaderStyle}"/>
                        
                        <!-- Project Information -->
                        <Border Background="White" BorderBrush="#E0E0E0" BorderThickness="1" CornerRadius="4" Padding="16" Margin="0,0,0,16">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="150"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Row="0" Grid.Column="0" Text="Project Name:" FontWeight="SemiBold" Margin="0,0,0,8"/>
                                <TextBlock Grid.Row="0" Grid.Column="1" x:Name="ProjectNameText" Text="Api.Db" Margin="0,0,0,8"/>

                                <TextBlock Grid.Row="1" Grid.Column="0" Text="Target Database:" FontWeight="SemiBold" Margin="0,0,0,8"/>
                                <TextBlock Grid.Row="1" Grid.Column="1" x:Name="TargetDatabaseConnection" Text="[(LOCALDB)\CORE].[Core.Db]" Margin="0,0,0,8"/>

                                <TextBlock Grid.Row="3" Grid.Column="0" Text="Last Deployment:" FontWeight="SemiBold"/>
                                <TextBlock Grid.Row="3" Grid.Column="1" x:Name="LastDeploymentText" Text="2025-01-11 14:23:45"/>
                            </Grid>
                        </Border>

                        <!-- Quick Actions -->
                        <TextBlock Text="Quick Actions" Style="{StaticResource SectionHeaderStyle}" Margin="0,16,0,12"/>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                            <Button Content="Refresh Changes" Style="{StaticResource PrimaryButtonStyle}" Margin="0,0,8,0" x:Name="RefreshChangesButton"/>
                            <Button Content="Compare Databases" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,8,0" x:Name="CompareDatabasesButton"/>
                            <Button Content="Deploy" Style="{StaticResource SecondaryButtonStyle}" x:Name="DeployButton"/>
                        </StackPanel>

                        <!-- Recent Activity -->
                        <TextBlock Text="Recent Activity" Style="{StaticResource SectionHeaderStyle}" Margin="0,16,0,12"/>
                        <Border Background="White" BorderBrush="#E0E0E0" BorderThickness="1" CornerRadius="4">
                            <ListBox x:Name="RecentActivityListBox" BorderThickness="0" Height="200">
                                <ListBoxItem Padding="12,8">
                                    <StackPanel>
                                        <TextBlock Text="[2025-01-11 14:23:45] Deployment completed successfully" FontWeight="SemiBold"/>
                                        <TextBlock Text="5 objects deployed" Foreground="#666666" FontSize="12"/>
                                    </StackPanel>
                                </ListBoxItem>
                                <ListBoxItem Padding="12,8">
                                    <StackPanel>
                                        <TextBlock Text="[2025-01-11 13:15:22] Database comparison completed" FontWeight="SemiBold"/>
                                        <TextBlock Text="12 differences found" Foreground="#666666" FontSize="12"/>
                                    </StackPanel>
                                </ListBoxItem>
                                <ListBoxItem Padding="12,8">
                                    <StackPanel>
                                        <TextBlock Text="[2025-01-11 11:45:10] Schema changes detected" FontWeight="SemiBold"/>
                                        <TextBlock Text="3 tables modified, 1 stored procedure added" Foreground="#666666" FontSize="12"/>
                                    </StackPanel>
                                </ListBoxItem>
                            </ListBox>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- Changes Tab -->
            <TabItem Header="Changes" Style="{StaticResource TabItemHeaderStyle}">
                <Grid Margin="20">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="Database Changes" Style="{StaticResource SectionHeaderStyle}"/>

                    <!-- Filter/Toolbar -->
                    <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,12">
                        <TextBlock Text="Filter:" VerticalAlignment="Center" Margin="0,0,8,0" FontWeight="SemiBold"/>
                        <ComboBox x:Name="ChangeTypeFilter" Width="150" Margin="0,0,16,0">
                            <ComboBoxItem Content="All Changes" IsSelected="True"/>
                            <ComboBoxItem Content="Tables"/>
                            <ComboBoxItem Content="Views"/>
                            <ComboBoxItem Content="Stored Procedures"/>
                            <ComboBoxItem Content="Functions"/>
                            <ComboBoxItem Content="Triggers"/>
                        </ComboBox>
                        <Button Content="Refresh" Style="{StaticResource SecondaryButtonStyle}" x:Name="RefreshChangesBtn"/>
                    </StackPanel>

                    <!-- Changes List -->
                    <Border Grid.Row="2" Background="White" BorderBrush="#E0E0E0" BorderThickness="1" CornerRadius="4">
                        <DataGrid x:Name="ChangesDataGrid" AutoGenerateColumns="False" IsReadOnly="True" 
                                  HeadersVisibility="Column" GridLinesVisibility="Horizontal" 
                                  BorderThickness="0" RowHeight="32">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Type" Binding="{Binding Type}" Width="120"/>
                                <DataGridTextColumn Header="Object Name" Binding="{Binding ObjectName}" Width="200"/>
                                <DataGridTextColumn Header="Schema" Binding="{Binding Schema}" Width="100"/>
                                <DataGridTextColumn Header="Change Type" Binding="{Binding ChangeType}" Width="120"/>
                                <DataGridTextColumn Header="Modified Date" Binding="{Binding ModifiedDate}" Width="150"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Border>

                    <!-- Status Bar -->
                    <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,12,0,0">
                        <TextBlock x:Name="ChangesCountText" Text="Total changes: 0" FontWeight="SemiBold"/>
                    </StackPanel>
                </Grid>
            </TabItem>

            <!-- Deployment Tab -->
            <TabItem Header="Deployment" Style="{StaticResource TabItemHeaderStyle}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="20">
                        <TextBlock Text="Deploy Database Changes" Style="{StaticResource SectionHeaderStyle}"/>

                        <!-- Deployment Configuration -->
                        <Border Background="White" BorderBrush="#E0E0E0" BorderThickness="1" CornerRadius="4" Padding="16" Margin="0,0,0,16">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="150"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Row="0" Grid.Column="0" Text="Server:" VerticalAlignment="Center" Margin="0,0,0,12"/>
                                <TextBox Grid.Row="0" Grid.Column="1" x:Name="DeployServerTextBox" Text="localhost\SQLEXPRESS" Margin="0,0,0,12" Padding="6"/>

                                <TextBlock Grid.Row="1" Grid.Column="0" Text="Database:" VerticalAlignment="Center" Margin="0,0,0,12"/>
                                <TextBox Grid.Row="1" Grid.Column="1" x:Name="DeployDatabaseTextBox" Text="ProductionDB" Margin="0,0,0,12" Padding="6"/>

                                <TextBlock Grid.Row="2" Grid.Column="0" Text="Authentication:" VerticalAlignment="Center" Margin="0,0,0,12"/>
                                <ComboBox Grid.Row="2" Grid.Column="1" x:Name="AuthenticationComboBox" Margin="0,0,0,12">
                                    <ComboBoxItem Content="Windows Authentication" IsSelected="True"/>
                                    <ComboBoxItem Content="SQL Server Authentication"/>
                                </ComboBox>

                                <CheckBox Grid.Row="3" Grid.Column="1" Content="Create backup before deployment" IsChecked="True" x:Name="BackupCheckBox"/>
                            </Grid>
                        </Border>

                        <!-- Deployment Options -->
                        <TextBlock Text="Deployment Options" Style="{StaticResource SectionHeaderStyle}"/>
                        <Border Background="White" BorderBrush="#E0E0E0" BorderThickness="1" CornerRadius="4" Padding="16" Margin="0,0,0,16">
                            <StackPanel>
                                <CheckBox Content="Generate deployment script only" Margin="0,0,0,8" x:Name="GenerateScriptCheckBox"/>
                                <CheckBox Content="Include transaction statements" IsChecked="True" Margin="0,0,0,8" x:Name="TransactionCheckBox"/>
                                <CheckBox Content="Drop objects not in source" Margin="0,0,0,8" x:Name="DropObjectsCheckBox"/>
                                <CheckBox Content="Ignore extended properties" x:Name="IgnoreExtendedPropsCheckBox"/>
                            </StackPanel>
                        </Border>

                        <!-- Deploy Button -->
                        <Button Content="Deploy Changes" Style="{StaticResource PrimaryButtonStyle}" Width="160" HorizontalAlignment="Left" x:Name="DeployChangesButton"/>

                        <!-- Deployment Log -->
                        <TextBlock Text="Deployment Log" Style="{StaticResource SectionHeaderStyle}" Margin="0,24,0,12"/>
                        <Border Background="White" BorderBrush="#E0E0E0" BorderThickness="1" CornerRadius="4">
                            <TextBox x:Name="DeploymentLogTextBox" Height="200" IsReadOnly="True" 
                                     VerticalScrollBarVisibility="Auto" TextWrapping="Wrap" 
                                     FontFamily="Consolas" FontSize="11" Padding="8"
                                     Text="Ready to deploy..."/>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- Settings Tab -->
            <TabItem Header="Settings" Style="{StaticResource TabItemHeaderStyle}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="20">
                        <TextBlock Text="Settings" Style="{StaticResource SectionHeaderStyle}"/>

                        <!-- PowerShell Settings -->
                        <TextBlock Text="PowerShell Configuration" FontWeight="SemiBold" FontSize="14" Margin="0,0,0,12"/>
                        <Border Background="White" BorderBrush="#E0E0E0" BorderThickness="1" CornerRadius="4" Padding="16" Margin="0,0,0,16">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="150"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Row="0" Grid.Column="0" Text="Scripts Path:" VerticalAlignment="Center" Margin="0,0,0,12"/>
                                <TextBox Grid.Row="0" Grid.Column="1" x:Name="ScriptsPathTextBox" Text="C:\DatabaseScripts" Margin="0,0,8,12" Padding="6"/>
                                <Button Grid.Row="0" Grid.Column="2" Content="Browse..." Margin="0,0,0,12" Padding="8,4" x:Name="BrowseScriptsButton"/>

                                <TextBlock Grid.Row="1" Grid.Column="0" Text="Execution Policy:" VerticalAlignment="Center"/>
                                <ComboBox Grid.Row="1" Grid.Column="1" x:Name="ExecutionPolicyComboBox" Margin="0,0,8,0">
                                    <ComboBoxItem Content="RemoteSigned" IsSelected="True"/>
                                    <ComboBoxItem Content="Unrestricted"/>
                                    <ComboBoxItem Content="AllSigned"/>
                                </ComboBox>
                            </Grid>
                        </Border>

                        <!-- General Settings -->
                        <TextBlock Text="General Settings" FontWeight="SemiBold" FontSize="14" Margin="0,0,0,12"/>
                        <Border Background="White" BorderBrush="#E0E0E0" BorderThickness="1" CornerRadius="4" Padding="16" Margin="0,0,0,16">
                            <StackPanel>
                                <CheckBox Content="Auto-refresh changes on project load" IsChecked="True" Margin="0,0,0,8" x:Name="AutoRefreshCheckBox"/>
                                <CheckBox Content="Show notifications on deployment completion" IsChecked="True" Margin="0,0,0,8" x:Name="NotificationsCheckBox"/>
                                <CheckBox Content="Enable verbose logging" x:Name="VerboseLoggingCheckBox"/>
                            </StackPanel>
                        </Border>

                        <!-- Save Settings Button -->
                        <Button Content="Save Settings" Style="{StaticResource PrimaryButtonStyle}" Width="140" HorizontalAlignment="Left" x:Name="SaveSettingsButton"/>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>
    </Grid>
</UserControl>
