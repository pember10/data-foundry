<UserControl x:Class="data_foundry.Views.Controls.SettingsTabControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="600" d:DesignWidth="800">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="20">
            <TextBlock Text="Settings" Style="{DynamicResource SectionHeaderStyle}"/>
            <!-- PowerShell Settings -->
            <TextBlock Text="PowerShell Configuration" FontWeight="SemiBold" FontSize="14" Margin="0,0,0,12"/>
            <Border Background="White" BorderBrush="#E0E0E0" BorderThickness="1" CornerRadius="4" Padding="16" Margin="0,0,0,16">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
						<RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="150"/>
                        <ColumnDefinition Width="300"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
					
					<TextBlock Grid.Row="0" Grid.Column="0" Text="SQL Project:" VerticalAlignment="Center" Margin="0,0,0,12"/>
					<ComboBox Grid.Row="0" Grid.Column="1" x:Name="SqlProjectComboBox" Margin="0,0,8,12"/>
					
					<TextBlock Grid.Row="1" Grid.Column="0" Text="Migrations Folder:" VerticalAlignment="Center" Margin="0,0,0,12"/>
					<ComboBox Grid.Row="1" Grid.Column="1" x:Name="MigrationsFolderComboBox" Margin="0,0,8,12"/>
                    
					<TextBlock Grid.Row="2" Grid.Column="0" Text="Execution Policy:" VerticalAlignment="Center"/>
                    <ComboBox Grid.Row="2" Grid.Column="1" x:Name="ExecutionPolicyComboBox" Margin="0,0,8,0">
                        <ComboBoxItem Content="RemoteSigned" IsSelected="True"/>
                        <ComboBoxItem Content="Unrestricted"/>
                        <ComboBoxItem Content="AllSigned"/>
                    </ComboBox>
                </Grid>
            </Border>
            <!-- General Settings -->
            <TextBlock Text="General Settings" FontWeight="SemiBold" FontSize="14" Margin="0,0,0,12"/>
            <Border Background="White" BorderBrush="#E0E0E0" BorderThickness="1" CornerRadius="4" Padding="16" Margin="0,0,0,16">
                <StackPanel>
                    <CheckBox Content="Auto-refresh changes on project load" IsChecked="True" Margin="0,0,0,8" x:Name="AutoRefreshCheckBox"/>
                    <CheckBox Content="Show notifications on deployment completion" IsChecked="True" Margin="0,0,0,8" x:Name="NotificationsCheckBox"/>
                    <CheckBox Content="Enable verbose logging" x:Name="VerboseLoggingCheckBox"/>
                </StackPanel>
            </Border>
            <!-- Save Settings Button -->
            <Button Content="Save Settings" Style="{DynamicResource PrimaryButtonStyle}" Width="140" HorizontalAlignment="Left" x:Name="SaveSettingsButton"/>
        </StackPanel>
    </ScrollViewer>
</UserControl>
