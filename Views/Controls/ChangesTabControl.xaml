<UserControl x:Class="data_foundry.Views.Controls.ChangesTabControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="600" d:DesignWidth="800">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Database Changes" Style="{DynamicResource SectionHeaderStyle}"/>

        <!-- Sync Status Indicator (separate row, always visible when out of sync) -->
        <Border Grid.Row="1" x:Name="SyncStatusPanel" BorderBrush="#FF9800" BorderThickness="1" CornerRadius="3" Padding="12" Background="#FFF3E0" Visibility="Collapsed" Margin="0,0,0,12">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="⚠" FontSize="16" Foreground="#FF9800" Margin="0,0,8,0" VerticalAlignment="Center"/>
                <StackPanel>
                    <TextBlock x:Name="SyncStatusText" Text="3 pending migrations" Foreground="#E65100" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,0,4"/>
                    <TextBlock Text="Your local database is out of sync with the migration scripts. Apply pending migrations before detecting changes." Foreground="#E65100" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,8"/>
                    <Button Content="Apply Pending Migrations" x:Name="ApplyPendingMigrationsBtn" Padding="12,6" FontSize="12" Background="#FF9800" Foreground="White" BorderThickness="0" Cursor="Hand" HorizontalAlignment="Left"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- Filter/Toolbar (hidden when out of sync) -->
        <StackPanel Grid.Row="1" x:Name="FilterToolbarPanel" Orientation="Horizontal" Margin="0,0,0,12">
            <TextBlock Text="Filter:" VerticalAlignment="Center" Margin="0,0,8,0" FontWeight="SemiBold"/>
            <ComboBox x:Name="ChangeTypeFilter" Width="180" Margin="0,0,16,0">
                <ComboBoxItem Content="All Changes" IsSelected="True"/>
                <ComboBoxItem Content="With Changes Only"/>
                <ComboBoxItem Content="No Changes"/>
            </ComboBox>
            <Button Content="Refresh Changes" Style="{DynamicResource PrimaryButtonStyle}" x:Name="RefreshChangesBtn" Margin="0,0,8,0"/>
            <Button Content="Revert Changes" Style="{DynamicResource SecondaryButtonStyle}" x:Name="RevertChangesBtn" Margin="0,0,8,0"/>
            <Button Content="Generate Script" Style="{DynamicResource SecondaryButtonStyle}" x:Name="GenerateScriptBtn"/>

            <!-- Loading Indicator -->
            <StackPanel x:Name="LoadingIndicator" Orientation="Horizontal" Margin="12,0,0,0">
                <!-- Processing Spinner -->
                <Grid x:Name="ProcessingIcon" Width="20" Height="20" Margin="0,0,8,0" Visibility="Collapsed">
                    <Ellipse Width="20" Height="20" Stroke="#2196F3" StrokeThickness="2" Opacity="0.3"/>
                    <Ellipse Width="20" Height="20" Stroke="#2196F3" StrokeThickness="2" 
                         StrokeDashArray="15,85" StrokeDashCap="Round">
                        <Ellipse.RenderTransform>
                            <RotateTransform x:Name="SpinnerRotate" CenterX="10" CenterY="10"/>
                        </Ellipse.RenderTransform>
                        <Ellipse.Triggers>
                            <EventTrigger RoutedEvent="Loaded">
                                <BeginStoryboard>
                                    <Storyboard RepeatBehavior="Forever">
                                        <DoubleAnimation Storyboard.TargetName="SpinnerRotate"
                                                   Storyboard.TargetProperty="Angle"
                                                   From="0" To="360" Duration="0:0:1.2"
                                                   AccelerationRatio="0.5" DecelerationRatio="0.5"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                        </Ellipse.Triggers>
                    </Ellipse>
                </Grid>

                <!-- Success Icon (Checkmark) -->
                <Grid x:Name="SuccessIcon" Width="20" Height="20" Margin="0,0,8,0" Visibility="Collapsed">
                    <Ellipse Width="20" Height="20" Fill="#4CAF50"/>
                    <Path Data="M 6,10 L 9,13 L 14,7" Stroke="White" StrokeThickness="2"/>
                </Grid>

                <!-- Error Icon (X) -->
                <Grid x:Name="ErrorIcon" Width="20" Height="20" Margin="0,0,8,0" Visibility="Collapsed">
                    <Ellipse Width="20" Height="20" Fill="#F44336"/>
                    <Path Data="M 7,7 L 13,13 M 13,7 L 7,13" Stroke="White" StrokeThickness="2"/>
                </Grid>

                <TextBlock x:Name="LoadingStatusText" Text="Idle..." FontStyle="Italic" Foreground="#666666" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <Button Content="Cancel" x:Name="CancelButton" Padding="8,4" Background="#F44336" Foreground="White" BorderThickness="0" Cursor="Hand" Visibility="Collapsed"/>
            </StackPanel>
        </StackPanel>

        <!-- Changes List -->
        <Border Grid.Row="3" Background="White" BorderBrush="#E0E0E0" BorderThickness="1" CornerRadius="4">
            <DataGrid x:Name="ChangesDataGrid" AutoGenerateColumns="False" IsReadOnly="True" 
                      HeadersVisibility="Column" GridLinesVisibility="Horizontal" 
                      BorderThickness="0" RowHeight="32">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Table" Binding="{Binding Table}" Width="300"/>
                    <DataGridTextColumn Header="Add" Binding="{Binding Inserts}" Width="100"/>
                    <DataGridTextColumn Header="Update" Binding="{Binding Updates}" Width="100"/>
                    <DataGridTextColumn Header="Delete" Binding="{Binding Deletes}" Width="100"/>
                </DataGrid.Columns>
            </DataGrid>
        </Border>
        <!-- Status Bar -->
        <StackPanel Grid.Row="4" Orientation="Horizontal" Margin="0,12,0,0">
            <TextBlock x:Name="ChangesCountText" Text="Total changes: 0" FontWeight="SemiBold"/>
        </StackPanel>
    </Grid>
</UserControl>
