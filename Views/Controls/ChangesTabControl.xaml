<UserControl x:Class="data_foundry.Views.Controls.ChangesTabControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="600" d:DesignWidth="800">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <TextBlock Grid.Row="0" Text="Database Changes" Style="{DynamicResource SectionHeaderStyle}"/>
        <!-- Filter/Toolbar -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,12">
            <TextBlock Text="Filter:" VerticalAlignment="Center" Margin="0,0,8,0" FontWeight="SemiBold"/>
            <ComboBox x:Name="ChangeTypeFilter" Width="180" Margin="0,0,16,0">
                <ComboBoxItem Content="All Changes" IsSelected="True"/>
                <ComboBoxItem Content="With Changes Only"/>
                <ComboBoxItem Content="No Changes"/>
            </ComboBox>
            <Button Content="Refresh Changes" Style="{DynamicResource SecondaryButtonStyle}" x:Name="RefreshChangesBtn"/>
        </StackPanel>
        <!-- Changes List -->
        <Border Grid.Row="2" Background="White" BorderBrush="#E0E0E0" BorderThickness="1" CornerRadius="4">
            <DataGrid x:Name="ChangesDataGrid" AutoGenerateColumns="False" IsReadOnly="True" 
                      HeadersVisibility="Column" GridLinesVisibility="Horizontal" 
                      BorderThickness="0" RowHeight="32">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Table" Binding="{Binding Table}" Width="200"/>
                    <DataGridTextColumn Header="Inserts" Binding="{Binding Inserts}" Width="100"/>
                    <DataGridTextColumn Header="Updates" Binding="{Binding Updates}" Width="100"/>
                    <DataGridTextColumn Header="Deletes" Binding="{Binding Deletes}" Width="100"/>
                    <DataGridCheckBoxColumn Header="Has Changes" Binding="{Binding HasChanges}" Width="120" IsReadOnly="True"/>
                </DataGrid.Columns>
            </DataGrid>
        </Border>
        <!-- Status Bar -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,12,0,0">
            <TextBlock x:Name="ChangesCountText" Text="Total changes: 0" FontWeight="SemiBold"/>
        </StackPanel>
    </Grid>
</UserControl>
