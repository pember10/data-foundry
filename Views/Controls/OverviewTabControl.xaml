<UserControl x:Class="data_foundry.Views.Controls.OverviewTabControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:converters="clr-namespace:data_foundry.Converters"
             mc:Ignorable="d"
             d:DesignHeight="600" d:DesignWidth="800">
    <UserControl.Resources>
        <converters:NullToVisibilityConverter x:Key="NullToVisibilityConverter"/>
    </UserControl.Resources>
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="20">
            <!-- Project Information -->
            <Border Background="White" BorderBrush="#E0E0E0" BorderThickness="1" CornerRadius="4" Padding="16" Margin="0,0,0,16">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="150"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    
                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Target Project Name:" FontWeight="SemiBold" Margin="0,0,0,8"/>
                    <TextBlock Grid.Row="0" Grid.Column="1" x:Name="TargetProjectNameText" Text="Api.Db" Margin="0,0,0,8"/>
                    
                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Source Database:" FontWeight="SemiBold" Margin="0,0,0,8"/>
                    <TextBlock Grid.Row="1" Grid.Column="1" x:Name="SourceDatabaseConnectionText" Text="[(LOCALDB)\CORE].[Core.Db]" Margin="0,0,0,8"/>
                    
                    <TextBlock Grid.Row="3" Grid.Column="0" Text="Last Deployment:" FontWeight="SemiBold"/>
                    <TextBlock Grid.Row="3" Grid.Column="1" x:Name="LastDeploymentText" Text="2025-01-11 14:23:45"/>
                </Grid>
            </Border>
            <!-- Quick Actions -->
            <TextBlock Text="Quick Actions" Style="{DynamicResource SectionHeaderStyle}" Margin="0,16,0,12"/>

            <!-- Sync Status Indicator -->
            <Border x:Name="SyncStatusPanel" BorderBrush="#FF9800" BorderThickness="1" CornerRadius="3" Padding="12" Background="#FFF3E0" Visibility="Collapsed" Margin="0,0,0,12">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="⚠" FontSize="16" Foreground="#FF9800" Margin="0,0,8,0" VerticalAlignment="Center"/>
                    <StackPanel>
                        <TextBlock x:Name="SyncStatusText" Text="3 pending migrations" Foreground="#E65100" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,0,4"/>
                        <TextBlock Text="Your local database is out of sync with the migration scripts. Apply pending migrations before detecting changes." Foreground="#E65100" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,8"/>
                        <Button Content="Apply Pending Migrations" x:Name="ApplyPendingMigrationsBtn" Padding="12,6" FontSize="12" Background="#FF9800" Foreground="White" BorderThickness="0" Cursor="Hand" HorizontalAlignment="Left"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <Grid Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                
                <!-- Main action buttons (hidden when out of sync) -->
                <StackPanel Grid.Column="0" x:Name="QuickActionsPanel" Orientation="Horizontal">
                    <Button Content="Refresh Changes" Style="{DynamicResource PrimaryButtonStyle}" Margin="0,0,8,0" x:Name="RefreshChangesButton"/>
                    <Button Content="Compare Databases" Style="{DynamicResource SecondaryButtonStyle}" Margin="0,0,8,0" x:Name="CompareDatabasesButton"/>
                    <Button Content="Deploy" Style="{DynamicResource SecondaryButtonStyle}" x:Name="DeployButton"/>
                    
                    <!-- Loading Indicator -->
                    <StackPanel x:Name="LoadingIndicator" Orientation="Horizontal" Margin="12,6,0,12">
                        <!-- Processing Spinner -->
                        <Grid x:Name="ProcessingIcon" Width="20" Height="20" Margin="0,0,8,0" Visibility="Collapsed">
                            <Ellipse Width="20" Height="20" Stroke="#2196F3" StrokeThickness="2" Opacity="0.3"/>
                            <Ellipse Width="20" Height="20" Stroke="#2196F3" StrokeThickness="2" 
                             StrokeDashArray="15,85" StrokeDashCap="Round">
                                <Ellipse.RenderTransform>
                                    <RotateTransform x:Name="SpinnerRotate" CenterX="10" CenterY="10"/>
                                </Ellipse.RenderTransform>
                                <Ellipse.Triggers>
                                    <EventTrigger RoutedEvent="Loaded">
                                        <BeginStoryboard>
                                            <Storyboard RepeatBehavior="Forever">
                                                <DoubleAnimation Storyboard.TargetName="SpinnerRotate"
                                                       Storyboard.TargetProperty="Angle"
                                                       From="0" To="360" Duration="0:0:1.2"
                                                       AccelerationRatio="0.5" DecelerationRatio="0.5"/>
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </EventTrigger>
                                </Ellipse.Triggers>
                            </Ellipse>
                        </Grid>

                        <!-- Success Icon (Checkmark) -->
                        <Grid x:Name="SuccessIcon" Width="20" Height="20" Margin="0,0,8,0" Visibility="Collapsed">
                            <Ellipse Width="20" Height="20" Fill="#4CAF50"/>
                            <Path Data="M 6,10 L 9,13 L 14,7" Stroke="White" StrokeThickness="2"/>
                        </Grid>

                        <!-- Error Icon (X) -->
                        <Grid x:Name="ErrorIcon" Width="20" Height="20" Margin="0,0,8,0" Visibility="Collapsed">
                            <Ellipse Width="20" Height="20" Fill="#F44336"/>
                            <Path Data="M 7,7 L 13,13 M 13,7 L 7,13" Stroke="White" StrokeThickness="2"/>
                        </Grid>

                        <TextBlock x:Name="LoadingStatusText" Text="Idle..." FontStyle="Italic" Foreground="#666666" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <Button Content="Cancel" x:Name="CancelButton" Padding="8,4" Background="#F44336" Foreground="White" BorderThickness="0" Cursor="Hand" Visibility="Collapsed"/>
                    </StackPanel>
                </StackPanel>
            </Grid>

            

            <!-- Recent Activity -->
            <TextBlock Text="Recent Activity" Style="{DynamicResource SectionHeaderStyle}" Margin="0,16,0,12"/>
            <Border Background="White" BorderBrush="#E0E0E0" BorderThickness="1" CornerRadius="4">
                <Grid>
                    <!-- Empty state message -->
                    <TextBlock x:Name="NoActivityMessage" 
                               Text="No recent activity. Perform a deployment or change detection to see activity here." 
                               Foreground="#999999" 
                               FontStyle="Italic"
                               TextAlignment="Center"
                               VerticalAlignment="Center"
                               Margin="20"
                               Visibility="Collapsed"/>
                    
                    <!-- Activity list -->
                    <ListBox x:Name="RecentActivityListBox" BorderThickness="0" Height="200">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="12,8">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding DisplayText}" FontWeight="SemiBold"/>
                                        <TextBlock Margin="8,0,0,0">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="#666666"/>
                                                    <Setter Property="FontSize" Value="12"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Status}" Value="Success">
                                                            <Setter Property="Foreground" Value="#4CAF50"/>
                                                            <Setter Property="Text" Value="✓ Success"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Status}" Value="Failed">
                                                            <Setter Property="Foreground" Value="#F44336"/>
                                                            <Setter Property="Text" Value="✗ Failed"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Status}" Value="Warning">
                                                            <Setter Property="Foreground" Value="#FF9800"/>
                                                            <Setter Property="Text" Value="⚠ Warning"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Status}" Value="InProgress">
                                                            <Setter Property="Foreground" Value="#2196F3"/>
                                                            <Setter Property="Text" Value="● In Progress"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Status}" Value="Cancelled">
                                                            <Setter Property="Foreground" Value="#9E9E9E"/>
                                                            <Setter Property="Text" Value="○ Cancelled"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </StackPanel>
                                    <TextBlock Text="{Binding Details}" Foreground="#666666" FontSize="12" 
                                              Visibility="{Binding Details, Converter={StaticResource NullToVisibilityConverter}}"/>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
